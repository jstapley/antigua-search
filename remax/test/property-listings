            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        
        .filter-icon {
            color: #0c2749;
            font-size: 1.2em;
            margin-right: 10px;
        }
        
        .filter-title {
            font-weight: 600;
            color: #333;
            font-size: 1.1em;
        }
        
        .filter-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .filter-label {
            font-weight: 500;
            color: #666;
            white-space: nowrap;
        }
        
        .filter-select {
            padding: 10px 15px;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            background: white;
            font-size: 14px;
            font-weight: 500;
            color: #333;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 180px;
        }
        
        .filter-select:focus {
            outline: none;
            border-color: #0c2749;
            box-shadow: 0 0 0 3px rgba(12, 39, 73, 0.1);
        }
        
        .search-input {
            padding: 10px 15px 10px 40px;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            background: white;
            font-size: 14px;
            font-weight: 500;
            color: #333;
            transition: all 0.3s ease;
            min-width: 250px;
            position: relative;
        }
        
        .search-input:focus {
            outline: none;
            border-color: #0c2749;
            box-shadow: 0 0 0 3px rgba(12, 39, 73, 0.1);
        }
        
        .search-input::placeholder {
            color: #999;
            font-weight: 400;
        }
        
        .search-container {
            position: relative;
            display: flex;
            align-items: center;
        }
        
        .search-icon {
            position: absolute;
            left: 12px;
            color: #666;
            font-size: 16px;
            z-index: 1;
            pointer-events: none;
        }
        
        .clear-search {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: #999;
            cursor: pointer;
            font-size: 18px;
            padding: 2px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .clear-search.visible {
            opacity: 1;
        }
        
        .clear-search:hover {
            color: #666;
        }
        
        .refresh-btn {
            background: #0c2749;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .refresh-btn:hover {
            background: #0a1f3a;
            transform: translateY(-1px);
        }
        
        .results-count {
            margin-left: auto;
            font-weight: 600;
            color: #0c2749;
            white-space: nowrap;
        }
        
        .properties-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            margin-bottom: 40px;
            justify-content: flex-start;
        }
        
        .property-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid #e9ecef;
            flex: 1 1 calc(50% - 15px);
            max-width: calc(50% - 15px);
            min-width: 350px;
        }
        
        @media (max-width: 1200px) {
            .property-card {
                flex: 1 1 calc(50% - 15px);
                max-width: calc(50% - 15px);
            }
        }
        
        @media (max-width: 800px) {
            .properties-grid {
                gap: 20px;
            }
            
            .property-card {
                flex: 1 1 100%;
                max-width: 100%;
                min-width: auto;
            }
        }
        
        .property-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }
        
        .property-image-wrapper {
            position: relative;
            width: 100%;
            height: 280px;
            cursor: pointer;
        }
        
        .property-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-bottom: 3px solid #6366f1;
        }
        
        .property-badges {
            position: absolute;
            top: 15px;
            left: 15px;
            display: flex;
            gap: 10px;
            z-index: 10;
        }
        
        .badge {
            padding: 8px 16px;
            border-radius: 4px;
            font-size: 0.85em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        
        .badge-featured {
            background: #ff6b35;
            color: white;
        }
        
        .badge-type {
            background: #4a90e2;
            color: white;
        }
        
        .property-content {
            padding: 25px;
        }
        
        .property-title {
            font-size: 1.4em;
            font-weight: 600;
            margin-bottom: 15px;
            color: #2c3e50;
        }
        
        .property-price {
            font-size: 1.6em;
            font-weight: 700;
            color: #27ae60;
            margin-bottom: 10px;
        }
        
        .property-features {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            font-size: 0.9em;
            color: #666;
        }
        
        .feature {
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .view-btn {
            display: inline-block;
            background: #0c2749;
            color: white;
            padding: 14px 28px;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            width: 100%;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }
        
        .view-btn:hover {
            background: #0a1f3a;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(12, 39, 73, 0.3);
        }
        
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin: 40px 0;
            flex-wrap: wrap;
        }
        
        .pagination button {
            padding: 10px 15px;
            border: 2px solid #0c2749;
            background: white;
            color: #0c2749;
            cursor: pointer;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .pagination button:hover:not(:disabled) {
            background: #0c2749;
            color: white;
            transform: translateY(-1px);
        }
        
        .pagination button.active {
            background: #0c2749;
            color: white;
        }
        
        .pagination button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .page-info {
            margin: 0 20px;
            font-weight: 600;
            color: #666;
        }
        
        .no-properties {
            text-align: center;
            padding: 60px 20px;
            color: #666;
            font-size: 1.2em;
        }
        
        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }
            
            .filters-section {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
            }
            
            .filter-group {
                justify-content: space-between;
            }
            
            .filter-select {
                min-width: auto;
                flex: 1;
            }
            
            .search-input {
                min-width: auto;
                width: 100%;
            }
            
            .results-count {
                margin-left: 0;
                text-align: center;
            }
            
            .property-card {
                width: 100%;
                flex: 1 1 100%;
            }
            
            .property-features {
                flex-direction: column;
                gap: 8px;
            }
            
            .pagination {
                gap: 5px;
            }
            
            .pagination button {
                padding: 8px 12px;
                font-size: 0.9em;
            }
            
            .page-info {
                margin: 0 10px;
                font-size: 0.9em;
            }
        }
    </style>
</head>
