        const PROPERTIES_PER_PAGE = 10;
        let currentPage = 1;
        let filteredProperties = [...PROPERTIES];

        function hasValue(value) {
            if (value === null || value === undefined || value === '') {
                return false;
            }
            const stringValue = String(value).trim();
            return stringValue !== '' && stringValue !== '0';
        }

        function searchProperties(searchTerm) {
            if (!searchTerm || searchTerm.trim() === '') {
                return [...PROPERTIES];
            }
            
            const term = searchTerm.toLowerCase().trim();
            return PROPERTIES.filter(property => 
                property.title.toLowerCase().includes(term)
            );
        }

        function clearSearch() {
            const searchInput = document.getElementById('search-input');
            searchInput.value = '';
            updateClearButton();
            applyFilters();
        }

        function updateClearButton() {
            const searchInput = document.getElementById('search-input');
            const clearButton = document.getElementById('clear-search');
            
            if (searchInput.value.trim() !== '') {
                clearButton.classList.add('visible');
            } else {
                clearButton.classList.remove('visible');
            }
        }

        function saveState() {
            const state = {
                currentPage: currentPage,
                propertyType: document.getElementById('property-type-filter').value,
                sortOrder: document.getElementById('price-sort-filter').value,
                searchTerm: document.getElementById('search-input').value
            };
            
            window.propertyListingState = state;
            
            const url = new URL(window.location);
            url.searchParams.set('page', currentPage);
            url.searchParams.set('type', state.propertyType);
            url.searchParams.set('sort', state.sortOrder);
            if (state.searchTerm) {
                url.searchParams.set('search', state.searchTerm);
            } else {
                url.searchParams.delete('search');
            }
            
            window.history.replaceState({}, '', url);
        }

        function loadState() {
            const urlParams = new URLSearchParams(window.location.search);
            const pageFromUrl = parseInt(urlParams.get('page')) || null;
            const typeFromUrl = urlParams.get('type') || null;
            const sortFromUrl = urlParams.get('sort') || null;
            const searchFromUrl = urlParams.get('search') || null;
            
            const sessionState = window.propertyListingState || null;
            
            currentPage = pageFromUrl || (sessionState ? sessionState.currentPage : 1);
            
            const propertyType = typeFromUrl || (sessionState ? sessionState.propertyType : 'all');
            const sortOrder = sortFromUrl || (sessionState ? sessionState.sortOrder : 'high-to-low');
            const searchTerm = searchFromUrl || (sessionState ? sessionState.searchTerm : '');
            
            document.getElementById('property-type-filter').value = propertyType;
            document.getElementById('price-sort-filter').value = sortOrder;
            document.getElementById('search-input').value = searchTerm;
            
            updateClearButton();
            
            return { currentPage, propertyType, sortOrder, searchTerm };
        }

        function filterAndSortProperties() {
            const typeFilter = document.getElementById('property-type-filter').value;
            const sortFilter = document.getElementById('price-sort-filter').value;
            const searchTerm = document.getElementById('search-input').value;
            
            let searchFiltered = searchProperties(searchTerm);
            
            // Filter out withdrawn properties
            searchFiltered = searchFiltered.filter(property => property.withdrawn !== 'yes');
            
            if (typeFilter === 'all') {
                filteredProperties = searchFiltered;
            } else {
                filteredProperties = searchFiltered.filter(property => property.type === typeFilter);
            }
            
            if (sortFilter === 'high-to-low') {
                filteredProperties.sort((a, b) => b.priceValue - a.priceValue);
            } else {
                filteredProperties.sort((a, b) => a.priceValue - b.priceValue);
            }
            
            document.getElementById('results-count').textContent = `${filteredProperties.length} Properties Found`;
            
            const totalPages = Math.ceil(filteredProperties.length / PROPERTIES_PER_PAGE);
            if (currentPage > totalPages && totalPages > 0) {
                currentPage = totalPages;
            } else if (currentPage < 1) {
                currentPage = 1;
            }
            
            saveState();
        }

        function renderProperties(page) {
            const container = document.getElementById('properties-container');
            const totalPages = Math.ceil(filteredProperties.length / PROPERTIES_PER_PAGE);
            const startIndex = (page - 1) * PROPERTIES_PER_PAGE;
            const endIndex = startIndex + PROPERTIES_PER_PAGE;
            const pageProperties = filteredProperties.slice(startIndex, endIndex);

            if (pageProperties.length === 0) {
                container.innerHTML = '<div class="no-properties">No properties found matching your criteria.</div>';
                return;
            }

            const propertiesHTML = `
                <div class="properties-grid">
                    ${pageProperties.map(property => {
                        const fullUrl = `https://remax-365-antigua.com${property.url}`;
                        const features = [];
                        
                        if (hasValue(property.bedrooms)) {
                            features.push(`🛏️ ${property.bedrooms} beds`);
                        }
                        
                        if (hasValue(property.bathrooms)) {
                            features.push(`🚿 ${property.bathrooms} baths`);
                        }
                        
                        if (hasValue(property.sqft)) {
                            features.push(`📐 ${property.sqft} sqft`);
                        }
                        
                        if (hasValue(property.lot_sqft)) {
                            features.push(`🏞️ ${property.lot_sqft} lot sqft`);
                        }

                        return `
                            <div class="property-card">
                                <div class="property-image-wrapper" onclick="window.open('${fullUrl}', '_blank')">
                                    <img src="${property.image}" alt="${property.title}" class="property-image" onerror="this.src='https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=400&h=300&fit=crop&crop=center'">
                                    <div class="property-badges">
                                        ${property.featured === 'yes' ? '<div class="badge badge-featured">Featured</div>' : ''}
                                        <div class="badge badge-type">${property.type}</div>
                                    </div>
                                </div>
                                <div class="property-content">
                                    <h3 class="property-title">${property.title}</h3>
                                    <div class="property-price">${property.price}</div>
                                    ${features.length > 0 ? `
                                        <div class="property-features">
                                            ${features.map(feature => `<div class="feature">${feature}</div>`).join('')}
                                        </div>
                                    ` : ''}
                                    <a href="${fullUrl}" target="_blank" class="view-btn" onclick="saveState()">View Details</a>
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;

            container.innerHTML = propertiesHTML;
        }

        function renderPagination() {
            const container = document.getElementById('pagination-container');
            const totalPages = Math.ceil(filteredProperties.length / PROPERTIES_PER_PAGE);
            
            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            let paginationHTML = '<div class="pagination">';
            
            paginationHTML += `<button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>← Previous</button>`;
            
            for (let i = 1; i <= totalPages; i++) {
                if (i === currentPage) {
                    paginationHTML += `<button class="active" onclick="changePage(${i})">${i}</button>`;
                } else if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 2) {
                    paginationHTML += `<button onclick="changePage(${i})">${i}</button>`;
                } else if (i === currentPage - 3 || i === currentPage + 3) {
                    paginationHTML += '<span>...</span>';
                }
            }
            
            paginationHTML += `<button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>Next →</button>`;
            
            const startItem = ((currentPage - 1) * PROPERTIES_PER_PAGE) + 1;
            const endItem = Math.min(currentPage * PROPERTIES_PER_PAGE, filteredProperties.length);
            paginationHTML += `<div class="page-info">Showing ${startItem}-${endItem} of ${filteredProperties.length} properties</div>`;
            
            paginationHTML += '</div>';
            
            container.innerHTML = paginationHTML;
        }

        function changePage(page) {
            const totalPages = Math.ceil(filteredProperties.length / PROPERTIES_PER_PAGE);
            if (page < 1 || page > totalPages) return;
            
            currentPage = page;
            saveState();
            renderProperties(currentPage);
            renderPagination();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function applyFilters() {
            currentPage = 1;
            filterAndSortProperties();
            renderProperties(currentPage);
            renderPagination();
        }

        window.addEventListener('popstate', function(event) {
            loadState();
            filterAndSortProperties();
            renderProperties(currentPage);
            renderPagination();
        });

        document.addEventListener('visibilitychange', function() {
            if (!document.hidden) {
                const savedState = loadState();
                if (savedState) {
                    filterAndSortProperties();
                    renderProperties(currentPage);
                    renderPagination();
                }
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            loadState();
            
            filterAndSortProperties();
            renderProperties(currentPage);
            renderPagination();
            
            document.getElementById('property-type-filter').addEventListener('change', applyFilters);
            document.getElementById('price-sort-filter').addEventListener('change', applyFilters);
            
            const searchInput = document.getElementById('search-input');
            
            let searchTimeout;
            searchInput.addEventListener('input', function() {
                updateClearButton();
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    applyFilters();
                }, 300);
            });
            
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    clearTimeout(searchTimeout);
                    applyFilters();
                }
            });
        });
    </script>
